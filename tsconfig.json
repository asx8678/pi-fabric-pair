{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Node16",
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/extension.js",
    "src/main.js",
    "src/worker.js",
    "src/controller.js",
    "src/actor-runtime.js",
    "src/rpc.js",
    "src/config.js",
    "src/schema.js",
    "src/contracts.js",
    "src/evidence.js",
    "src/native.js",
    "src/util.js",
    "src/metrics.js",
    "src/observations.js",
    "src/ui.js"
  ]
}
