{
  "name": "pi-fabric-pair",
  "version": "0.1.0",
  "description": "Persistent, review-gated Pi RPC workers alongside an unchanged Pi + Fabric + Fovea main session.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "fabric",
    "fovea",
    "persistent-workers"
  ],
  "pi": {
    "extensions": [
      "./src/extension.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "src",
    "skills",
    "docs/assets/pi-fabric-pair-architecture.svg",
    "docs/assets/pi-fabric-pair-review-loop.svg",
    "docs/assets/pi-fabric-pair-context.svg",
    "README.md",
    "LICENSE",
    "fabric-pair.example.json"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run typecheck",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  }
}
