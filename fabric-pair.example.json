{
  "version": 2,
  "enabled": false,
  "autoStart": false,
  "indicator": "minimal",
  "maxWorkers": 1,
  "workers": [
    {
      "id": "worker",
      "provider": "YOUR_PROVIDER_FROM_PI",
      "model": "YOUR_WORKER_MODEL_ID",
      "effort": "medium",
      "cwd": null,
      "readOnly": false
    }
  ],
  "supervision": {
    "mode": "every-step",
    "finalReview": true,
    "maxRevisions": 20,
    "maxRevisionsPerStep": 3,
    "summaryDetail": "normal",
    "maxStepFiles": 5,
    "enforceStepScope": false
  },
  "runtime": {
    "backend": "pi",
    "lowCommand": "low",
    "lowArgs": [],
    "command": "pi",
    "commandArgs": [],
    "extraExtensions": [],
    "excludeExtensions": [],
    "extraSkills": [],
    "inheritExtensions": true,
    "mcp": true,
    "startupTimeoutMs": 120000,
    "requestTimeoutMs": 30000,
    "shutdownTimeoutMs": 5000
  },
  "requirements": {
    "fabric": true,
    "fovea": true,
    "prewalkDisabled": true,
    "autoCompaction": true
  },
  "limits": {
    "activeStepTimeoutMs": 1800000,
    "maxReportsPerTask": 40,
    "maxReportBytes": 16384,
    "maxAutomaticReportRepairs": 1,
    "maxReportedCostUsd": null,
    "maxOutputTokens": null
  },
  "control": {
    "watchdog": true,
    "silentMs": 300000,
    "pingTimeoutMs": 20000,
    "toolMaxMs": 900000,
    "stepNudgeMs": 1200000,
    "maxAutoRecoveriesPerStep": 2,
    "autoRepairsPerStep": 2,
    "blockedCommands": [
      "git\\s+commit\\b", "git\\s+push\\b", "git\\s+reset\\s+--hard\\b", "git\\s+checkout\\s+--\\s", "git\\s+clean\\s+-[a-z]*f",
      "git\\s+rebase\\b", "git\\s+stash\\b", "git\\s+branch\\s+-D\\b", "(npm|pnpm|yarn|bun)\\s+publish\\b", "sudo(\\s|$)",
      "rm\\s+-[a-zA-Z]*[rR][a-zA-Z]*[fF][a-zA-Z]*\\s+(/|~)", "rm\\s+-[a-zA-Z]*[fF][a-zA-Z]*[rR][a-zA-Z]*\\s+(/|~)",
      "rm\\s+(?:-[rR]\\s+-[fF]|-[fF]\\s+-[rR])\\s+(/|~)"
    ],
    "defaultShellTimeoutS": 600,
    "noReportNudges": 1,
    "maxSteersPerStep": 6,
    "providerCooldownMs": 60000,
    "quotaCooldownMs": 900000,
    "maxProviderWaits": 4,
    "fallbackAfterWaits": 2,
    "compactionMaxMs": 600000,
    "compactBeforeTaskTokens": 200000,
    "freshSessionAboveTokens": 600000,
    "mainHeartbeat": "off",
    "mainHeartbeatMs": 900000
  },
  "verification": {
    "commands": [],
    "requirePassing": true,
    "timeoutMs": 120000
  },
  "evidence": {
    "maxFiles": 25000,
    "maxTotalBytes": 536870912,
    "maxArtifactBytes": 67108864
  },
  "mainReadOnlyDuringTasks": true,
  "autoDeliverReports": true,
  "autoCheckIdle": true,
  "peerReview": {
    "enabled": false,
    "provider": "xai",
    "model": "grok-4.7",
    "on": "final",
    "timeoutMs": 600000
  },
  "mainSupervision": false,
  "attentionCue": false,
  "maxMainRecoveries": 3
}
